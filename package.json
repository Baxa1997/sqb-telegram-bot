{
   "name": "venture-telegram-bot",
   "private": true,
   "version": "0.1.0",
   "type": "module",
   "packageManager": "yarn@1.22.22",
   "scripts": {
      "dev": "node --experimental-strip-types --env-file-if-exists=.env.local src/index.ts",
      "start": "node --experimental-strip-types --env-file-if-exists=.env src/index.ts",
      "login": "node --experimental-strip-types --env-file-if-exists=.env.local src/login.ts",
      "type-check": "tsc --noEmit",
      "news:try": "node --experimental-strip-types src/news/try.ts"
   },
   "dependencies": {
      "@anthropic-ai/sdk": "1.2.0",
      "fast-xml-parser": "5.11.2",
      "qrcode": "1.5.4",
      "telegram": "2.26.22"
   },
   "devDependencies": {
      "@types/node": "^26.1.2",
      "@types/qrcode": "1.5.6",
      "typescript": "7.0.2"
   },
   "engines": {
      "node": "22.x",
      "yarn": ">=1.22.0"
   }
}
