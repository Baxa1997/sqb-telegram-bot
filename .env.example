# The bot of @BotFather: the test bot here, the real one in Vault. Never commit it.
TELEGRAM_BOT_TOKEN=

# Seals what the server keeps in ucode (the fund account's session, its own
# private key). Any long random string; never change it once set, or the fund
# account has to be connected again.
TELEGRAM_SECRET=

# Our Telegram app, made once by the developer at my.telegram.org → «API
# development tools» (any number may make it). With it the fund's own account
# is linked in the panel by a QR code (Настройки → Интеграции), and that
# account creates the deals' groups. Without it the bot works by link.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Only to give the fund's account here instead of linking it in the panel
# (`yarn login` prints it). It is the whole account: Vault, never a chat.
TELEGRAM_SESSION=

# The ucode project the panel uses, with its API key (as the cabinet's server).
UCODE_API_KEY=
UCODE_PROJECT_ID=
UCODE_BASE_URL=https://api.client.u-code.io
UCODE_FILES_URL=https://cdn.u-code.io

# The news collector (src/news). Without a key it picks the website's news by
# the sources' keywords and the fund's names; with one, Claude reads each
# candidate and writes the title and summary in ru/uz/en. Vault, never a chat.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (the latest Haiku) unless set; claude-opus-5-5 writes better
# and costs far more per article.
ANTHROPIC_MODEL=claude-haiku-5-5
